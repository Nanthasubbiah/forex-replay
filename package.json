{
  "name": "forex-replay",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Free, self-hosted, browser-based MT4-style forex backtesting desk",
  "license": "MIT",
  "keywords": [
    "forex",
    "backtesting",
    "trading",
    "simulator",
    "mt4",
    "candlestick",
    "replay"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lightweight-charts": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright-core": "^1.64.1",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
